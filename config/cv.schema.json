{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "description": "Professional title or target role."
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "description": "Phone number (e.g. '+989120000000' or '+1 (555) 123-4567')."
        },
        "location": {
          "type": "string",
          "description": "City and country, or preferred location format."
        },
        "timeZone": {
          "type": "string",
          "description": "Time zone (e.g. UTC+3:30)."
        },
        "website": {
          "type": "string",
          "description": "A valid HTTP or HTTPS URL."
        },
        "portrait": {
          "type": "string",
          "description": "Image URL or root-relative path (e.g. \"/portrait.jpg\")."
        },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": ["github", "gitlab", "linkedin", "telegram", "whatsapp"]
              },
              "url": {
                "type": "string",
                "description": "A valid HTTP or HTTPS URL."
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["platform", "url"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "headline",
        "email",
        "phone",
        "location",
        "timeZone"
      ],
      "additionalProperties": false
    },
    "summary": {
      "description": "A concise professional summary.",
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Job title or position."
          },
          "startDate": {
            "type": "string",
            "description": "Use \"Mon YYYY\" (e.g. \"Jan 2025\") or \"YYYY\"."
          },
          "endDate": {
            "description": "Leave empty for a current position.",
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "workMode": {
            "type": "string",
            "enum": ["On-site", "Hybrid", "Remote"]
          },
          "description": {
            "description": "Brief overview of your responsibilities.",
            "type": "string"
          },
          "highlights": {
            "description": "Key achievements and measurable results.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["company", "title", "startDate"],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Skill group name (e.g. Backend, Languages)."
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skills belonging to this category."
          }
        },
        "required": ["category", "items"],
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "description": "Use \"Mon YYYY\" (e.g. \"Jan 2025\") or \"YYYY\"."
          },
          "endDate": {
            "description": "Leave empty for an ongoing project.",
            "type": "string"
          },
          "projectUrl": {
            "description": "General project page.",
            "type": "string"
          },
          "liveUrl": {
            "description": "Live deployment URL.",
            "type": "string"
          },
          "repositoryUrl": {
            "description": "Source code repository URL.",
            "type": "string"
          },
          "technologies": {
            "description": "Technologies and tools used.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlights": {
            "description": "Key features, contributions, or results.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["title", "description", "startDate"],
        "additionalProperties": false
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Use \"Mon YYYY\" (e.g. \"Jan 2025\") or \"YYYY\"."
          },
          "url": {
            "type": "string",
            "description": "A valid HTTP or HTTPS URL."
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["title", "date"],
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "description": "Use \"Mon YYYY\" (e.g. \"Jan 2025\") or \"YYYY\"."
          },
          "endDate": {
            "description": "Leave empty if currently studying.",
            "type": "string"
          },
          "topGrades": {
            "description": "Notable grades or GPA.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "grade": {
                  "type": "string"
                }
              },
              "required": ["label", "grade"],
              "additionalProperties": false
            }
          },
          "honors": {
            "description": "Academic honors, awards, or distinctions.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["institution", "degree", "startDate"],
        "additionalProperties": false
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Use \"Mon YYYY\" (e.g. \"Jan 2025\") or \"YYYY\"."
          },
          "url": {
            "type": "string",
            "description": "A valid HTTP or HTTPS URL."
          }
        },
        "required": ["name", "issuer", "date"],
        "additionalProperties": false
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "proficiency": {
            "type": "string",
            "enum": [
              "Elementary",
              "Limited Working",
              "Professional Working",
              "Full Professional",
              "Native or Bilingual"
            ]
          }
        },
        "required": ["name", "proficiency"],
        "additionalProperties": false
      }
    }
  },
  "required": ["basics"],
  "additionalProperties": false
}
