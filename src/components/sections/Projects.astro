---
import type { ProjectItem } from "../../types/cv";
import Section from "../Section.astro";

interface Props {
  items?: ProjectItem[];
  title?: string;
}

const { items, title = "Projects" } = Astro.props;

if (!items || items.length === 0) {
  return;
}
---

<Section id="projects" title={title}>
    <div class="cv-item-list">
        {items.map((item) => {
            const primaryUrl =
                item.projectUrl || item.liveUrl || item.repositoryUrl;

            return (
                <article class="cv-item">
                    <div class="cv-item-header">
                        <div class="cv-project-title-group">
                            <h3 class="cv-item-title">
                                {primaryUrl ? (
                                    <a
                                        href={primaryUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <bdi>{item.title}</bdi>
                                    </a>
                                ) : (
                                    <bdi>{item.title}</bdi>
                                )}
                            </h3>

                            <div class="cv-project-labels">
                                {item.liveUrl && (
                                    <a
                                        href={item.liveUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="cv-project-label cv-label-live"
                                    >
                                        Live
                                    </a>
                                )}
                                {item.repositoryUrl && (
                                    <a
                                        href={item.repositoryUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="cv-project-label cv-label-oss"
                                    >
                                        Open Source
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>

                    <p class="cv-item-description">{item.description}</p>

                    {item.highlights && item.highlights.length > 0 && (
                        <ul>
                            {item.highlights.map((highlight) => (
                                <li>{highlight}</li>
                            ))}
                        </ul>
                    )}

                    {item.technologies && item.technologies.length > 0 && (
                        <div class="cv-tags" aria-label="Technologies used">
                            {item.technologies.map((tech) => (
                                <span class="cv-tag">{tech}</span>
                            ))}
                        </div>
                    )}
                </article>
            );
        })}
    </div>
</Section>

<style>
    .cv-project-title-group {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .cv-project-labels {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .cv-project-label {
        display: inline-flex;
        align-items: center;
        font-size: var(--font-size-xs);
        font-weight: 500;
        padding-inline: 0.45rem;
        padding-block: 0.125rem;
        border-radius: 0.25rem;
        line-height: 1.3;
        text-decoration: none;
        transition: opacity 0.15s ease;
    }

    .cv-project-label:hover {
        opacity: 0.8;
    }

    .cv-label-live {
        background-color: #15803d;
        color: #ffffff;
        border: 1px solid #15803d;
    }

    .cv-label-oss {
        background-color: #6d28d9;
        color: #ffffff;
        border: 1px solid #6d28d9;
    }
</style>
