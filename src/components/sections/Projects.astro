---
import type { ProjectItem } from "../../types/cv";
import Section from "../Section.astro";

interface Props {
  items?: ProjectItem[];
  title?: string;
}

const { items, title = "Selected Projects" } = Astro.props;

if (!items || items.length === 0) {
  return;
}
---

<Section id="projects" title={title}>
    <div class="cv-item-list">
        {items.map((item) => {
            const primaryUrl =
                item.projectUrl || item.liveUrl || item.repositoryUrl;

            return (
                <article class="cv-item">
                    <div class="cv-item-header">
                        <div class="cv-project-title-group">
                            <h3 class="cv-item-title">
                                {primaryUrl ? (
                                    <a
                                        href={primaryUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <bdi>{item.title}</bdi>
                                    </a>
                                ) : (
                                    <bdi>{item.title}</bdi>
                                )}
                            </h3>

                            <div
                                class="cv-project-labels"
                                role="group"
                                aria-label="Project links"
                            >
                                {item.liveUrl && (
                                    <a
                                        href={item.liveUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="cv-project-label cv-label-live"
                                        aria-label="Live Demo"
                                    >
                                        Live
                                    </a>
                                )}
                                {item.repositoryUrl && (
                                    <a
                                        href={item.repositoryUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="cv-project-label cv-label-oss"
                                        aria-label="Open Source Repository"
                                    >
                                        Open Source
                                    </a>
                                )}
                            </div>
                        </div>

                        <span class="cv-item-date">
                            <bdi>
                                {item.startDate} - {item.endDate || "Present"}
                            </bdi>
                        </span>
                    </div>

                    <p class="cv-item-description">{item.description}</p>

                    {item.highlights && item.highlights.length > 0 && (
                        <ul>
                            {item.highlights.map((highlight) => (
                                <li>{highlight}</li>
                            ))}
                        </ul>
                    )}

                    {item.technologies && item.technologies.length > 0 && (
                        <p
                            class="cv-project-technologies"
                            aria-label="Technologies used"
                        >
                            {item.technologies.map((tech, index) => (
                                <span class="cv-tech-item">
                                    {tech}
                                    {index < item.technologies!.length - 1 &&
                                        ", "}
                                </span>
                            ))}
                        </p>
                    )}
                </article>
            );
        })}
    </div>
</Section>

<style>
    .cv-project-title-group {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .cv-project-labels {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .cv-project-label {
        display: inline-flex;
        align-items: center;
        font-size: var(--font-size-xs);
        font-weight: 500;
        padding-inline: 0.5rem;
        padding-block: 0.15rem;
        border-radius: 0.25rem;
        line-height: 1.25;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .cv-project-label:hover {
        opacity: 0.85;
    }

    .cv-label-live {
        background-color: #f0fdf4;
        color: #166534;
        border: 1px solid #86efac;
    }

    .cv-label-oss {
        background-color: #faf5ff;
        color: #6b21a8;
        border: 1px solid #d8b4fe;
    }

    .cv-project-technologies {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.2rem 0.3rem;
        font-size: var(--font-size-xs);
        line-height: var(--line-height-tight);
        margin-block-start: 0.15rem;
    }

    .cv-tech-item {
        display: inline;
        font-weight: 500;
        color: var(--color-fg);
    }
</style>
