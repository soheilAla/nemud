---
import type { ExperienceItem } from "../../types/cv";
import FormattedText from "../FormattedText.astro";
import Section from "../Section.astro";

interface Props {
  items?: ExperienceItem[];
  title?: string;
}

const { items, title = "Experience" } = Astro.props;

if (!items || items.length === 0) {
  return;
}
---

<Section id="experience" title={title}>
    <div class="cv-item-list">
        {items.map((item) => (
            <article class="cv-item">
                <div class="cv-item-header">
                    <div>
                        <h3 class="cv-item-title">{item.title}</h3>
                        <div class="cv-item-subtitle">
                            <span class="cv-item-company">{item.company}</span>
                            {item.location && (
                                <span class="cv-item-location">
                                    {" "}
                                    | {item.location}
                                </span>
                            )}
                            {item.workMode && (
                                <span class="cv-item-workmode">
                                    {" "}
                                    | {item.workMode}
                                </span>
                            )}
                        </div>
                    </div>
                    <span class="cv-item-date">
                        <bdi>
                            {item.startDate} - {item.endDate || "Present"}
                        </bdi>
                    </span>
                </div>

                {item.description && (
                    <p class="cv-item-description">
                        <FormattedText text={item.description} />
                    </p>
                )}

                {item.highlights && item.highlights.length > 0 && (
                    <ul>
                        {item.highlights.map((highlight) => (
                            <li>
                                <FormattedText text={highlight} />
                            </li>
                        ))}
                    </ul>
                )}
            </article>
        ))}
    </div>
</Section>
