---
import type { ExperienceItem } from "../../types/cv";
import Section from "../Section.astro";

interface Props {
  items?: ExperienceItem[];
  title?: string;
}

const { items, title = "Experience" } = Astro.props;

if (!items || items.length === 0) {
  return;
}
---

<Section id="experience" title={title}>
    <div class="cv-item-list">
        {items.map((item) => (
            <article class="cv-item">
                <div class="cv-item-header">
                    <div>
                        <h3 class="cv-item-title">{item.title}</h3>
                        <div class="cv-item-subtitle">
                            {item.company}
                            {item.location && ` · ${item.location}`}
                        </div>
                    </div>
                    <span class="cv-item-date">
                        <bdi>
                            {item.startDate} — {item.endDate || "Present"}
                        </bdi>
                    </span>
                </div>

                {item.description && (
                    <p class="cv-item-description">{item.description}</p>
                )}

                {item.highlights && item.highlights.length > 0 && (
                    <ul>
                        {item.highlights.map((highlight) => (
                            <li>{highlight}</li>
                        ))}
                    </ul>
                )}
            </article>
        ))}
    </div>
</Section>
