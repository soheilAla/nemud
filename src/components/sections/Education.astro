---
import type { EducationItem } from "../../types/cv";
import Section from "../Section.astro";

interface Props {
  items?: EducationItem[];
  title?: string;
}

const { items, title = "Education" } = Astro.props;

if (!items || items.length === 0) {
  return;
}
---

<Section id="education" title={title}>
    <div class="cv-item-list">
        {items.map((item) => (
            <article class="cv-item">
                <div class="cv-item-header">
                    <div>
                        <h3 class="cv-item-title">
                            {item.degree}
                            {item.field && ` in ${item.field}`}
                        </h3>
                        <div class="cv-item-subtitle">{item.institution}</div>
                    </div>
                    <span class="cv-item-date">
                        <bdi>
                            {item.startDate} - {item.endDate || "Present"}
                        </bdi>
                    </span>
                </div>

                {item.honors && item.honors.length > 0 && (
                    <ul>
                        {item.honors.map((honor) => (
                            <li>{honor}</li>
                        ))}
                    </ul>
                )}
            </article>
        ))}
    </div>
</Section>
