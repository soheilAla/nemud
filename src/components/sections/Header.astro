---
import type { Basics } from "../../types/cv";
import Icon from "../Icon.astro";

interface Props {
  basics: Basics;
}

const { basics } = Astro.props;
---

<header class="cv-header">
    <div class="cv-header-main">
        <h1 class="cv-name">{basics.name}</h1>
        <p class="cv-headline">{basics.headline}</p>
    </div>

    <div class="cv-header-meta">
        <!-- Direct Contact Information -->
        <div
            class="cv-meta-row cv-contact-row"
            role="list"
            aria-label="Contact Information"
        >
            {basics.location && (
                <div class="cv-meta-item" role="listitem">
                    <Icon name="location" />
                    <span
                        aria-label={`Location: ${basics.location}${basics.timeZone ? ` (${basics.timeZone})` : ""}`}
                    >
                        <bdi>
                            {basics.location}
                            {basics.timeZone && ` (${basics.timeZone})`}
                        </bdi>
                    </span>
                </div>
            )}

            {basics.phone && (
                <div class="cv-meta-item" role="listitem">
                    <Icon name="phone" />
                    <a
                        href={`tel:${basics.phone}`}
                        aria-label={`Phone: ${basics.phone}`}
                    >
                        <bdi>{basics.phone}</bdi>
                    </a>
                </div>
            )}

            {basics.email && (
                <div class="cv-meta-item" role="listitem">
                    <Icon name="email" />
                    <a
                        href={`mailto:${basics.email}`}
                        aria-label={`Email: ${basics.email}`}
                    >
                        <bdi>{basics.email}</bdi>
                    </a>
                </div>
            )}

            {basics.website && (
                <div class="cv-meta-item" role="listitem">
                    <Icon name="website" />
                    <a
                        href={basics.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Website: ${basics.website}`}
                    >
                        <bdi>{basics.website.replace(/^https?:\/\//, "")}</bdi>
                    </a>
                </div>
            )}
        </div>

        <!-- Social Media Profiles -->
        {basics.socials && basics.socials.length > 0 && (
            <div
                class="cv-meta-row cv-socials-row"
                role="list"
                aria-label="Social Media"
            >
                {basics.socials.map((social) => {
                    const appName =
                        social.label ||
                        (social.platform === "github"
                            ? "GitHub"
                            : social.platform === "linkedin"
                              ? "LinkedIn"
                              : social.platform === "x"
                                ? "X"
                                : social.platform.charAt(0).toUpperCase() +
                                  social.platform.slice(1));

                    return (
                        <div class="cv-meta-item" role="listitem">
                            <Icon name={social.platform} />
                            <a
                                href={social.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`${appName} Profile`}
                            >
                                <bdi>{appName}</bdi>
                            </a>
                        </div>
                    );
                })}
            </div>
        )}
    </div>
</header>

<style>
    .cv-header {
        display: flex;
        flex-direction: column;
        row-gap: 0.75rem;
        padding-block-end: 0.25rem;
    }

    .cv-header-main {
        display: flex;
        flex-direction: column;
        row-gap: 0.25rem;
    }

    .cv-name {
        font-size: var(--font-size-2xl);
        letter-spacing: -0.015em;
    }

    .cv-headline {
        font-size: var(--font-size-lg);
        color: var(--color-muted);
        font-weight: 400;
    }

    .cv-header-meta {
        display: flex;
        flex-direction: column;
        row-gap: 0.45rem;
    }

    .cv-meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem 1.25rem;
        font-size: var(--font-size-sm);
        color: var(--color-muted);
    }

    .cv-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }
</style>
