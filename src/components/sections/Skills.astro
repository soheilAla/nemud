---
import type { SkillCategory } from "../../types/cv";
import Section from "../Section.astro";

interface Props {
  skills?: SkillCategory[];
  title?: string;
}

const { skills, title = "Skills" } = Astro.props;

if (!skills || skills.length === 0) {
  return;
}
---

<Section id="skills" title={title}>
  <div class="cv-skills-grid">
    {skills.map((cat) => (
      <div class="cv-skill-category">
        <h3 class="cv-skill-cat-title">{cat.category}</h3>
        <div class="cv-tags">
          {cat.items.map((item) => (
            <span class="cv-tag">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  .cv-skills-grid {
    display: flex;
    flex-direction: column;
    row-gap: 0.75rem;
  }

  .cv-skill-category {
    display: flex;
    flex-direction: column;
    row-gap: 0.25rem;
  }

  .cv-skill-cat-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-fg);
  }
</style>
