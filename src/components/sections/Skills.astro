---
import type { SkillCategory } from "../../types/cv";
import Section from "../Section.astro";

interface Props {
  skills?: SkillCategory[];
  title?: string;
}

const { skills, title = "Skills" } = Astro.props;

if (!skills || skills.length === 0) {
  return;
}
---

<Section id="skills" title={title}>
  <div class="cv-skills-list">
    {skills.map((cat) => (
      <div class="cv-skill-row">
        <h3 class="cv-skill-category-name">{cat.category}:</h3>
        <p class="cv-skill-items">
          {cat.items.map((item, index) => (
            <span class="cv-skill-item">
              {item}
              {index < cat.items.length - 1 && ", "}
            </span>
          ))}
        </p>
      </div>
    ))}
  </div>
</Section>

<style>
.cv-skills-list {
  display: flex;
  flex-direction: column;
  row-gap: 0.4rem;
}

.cv-skill-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25rem 0.5rem;
  font-size: var(--font-size-sm);
  line-height: var(--line-height-tight);
}

.cv-skill-category-name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-fg);
  white-space: nowrap;
  margin: 0;
}

.cv-skill-items {
  color: var(--color-muted);
  margin: 0;
}

.cv-skill-item {
  display: inline;
}
</style>
