---
import Certifications from "../components/sections/Certifications.astro";
import Education from "../components/sections/Education.astro";
import Experience from "../components/sections/Experience.astro";
import Header from "../components/sections/Header.astro";
import Languages from "../components/sections/Languages.astro";
import Projects from "../components/sections/Projects.astro";
import Publications from "../components/sections/Publications.astro";
import Skills from "../components/sections/Skills.astro";
import Summary from "../components/sections/Summary.astro";
import { loadSiteConfig, resolveSiteConfig } from "../config/resolve";
import { cvData } from "../data/cv";
import CVLayout from "../layouts/CVLayout.astro";
import type { BodySectionKey } from "../types/site";

const config = resolveSiteConfig(loadSiteConfig());

function isSectionNonEmpty(key: BodySectionKey): boolean {
  const data = cvData[key];
  if (!data) return false;
  return Array.isArray(data) ? data.length > 0 : true;
}

const activeSections = config.sectionOrder.filter(
  (key) => config.sectionVisibility[key] && isSectionNonEmpty(key),
);

const pageTitle = `${cvData.basics.name} - ${cvData.basics.headline}`;
---

<CVLayout title={pageTitle} description={cvData.summary} config={config}>
  <Header basics={cvData.basics} showPortrait={config.showPortrait} />
  {cvData.summary && <Summary summary={cvData.summary} />}

  {activeSections.map((sectionKey) => {
    switch (sectionKey) {
      case "experience":
        return cvData.experience ? (
          <Experience items={cvData.experience} />
        ) : null;
      case "skills":
        return cvData.skills ? <Skills skills={cvData.skills} /> : null;
      case "projects":
        return cvData.projects ? <Projects items={cvData.projects} /> : null;
      case "education":
        return cvData.education ? <Education items={cvData.education} /> : null;
      case "certifications":
        return cvData.certifications ? (
          <Certifications items={cvData.certifications} />
        ) : null;
      case "publications":
        return cvData.publications ? (
          <Publications items={cvData.publications} />
        ) : null;
      case "languages":
        return cvData.languages ? <Languages items={cvData.languages} /> : null;
      default:
        return null;
    }
  })}
</CVLayout>
