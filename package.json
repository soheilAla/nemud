    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@12.5.1"
}
