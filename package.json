{
  "name": "nemud",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "schema": "node --no-warnings --experimental-strip-types scripts/generate-schema.ts && biome format --write config/cv.schema.json config/site.schema.json",
